# Copy to .env and fill in. Never commit the real .env.

# Funded testnet deployer key. Get testnet ETH from the faucet first:
#   https://faucet.testnet.chain.robinhood.com
# This key owns every deployed contract (EarnPool owner, factory owner) — treat it accordingly.
DEPLOYER_PRIVATE_KEY=

# Robinhood Chain testnet. The default matches the documented public endpoint.
TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Where the deploy reads REAL feed prices from to seed the mock oracles. This is Robinhood
# mainnet — the same feeds the fork reads — fetched with plain eth_call, no fork required.
MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Optional price pins (decimal dollars, e.g. 2385.90). Set one to skip the live read for that
# asset. Without them every price is fetched live at deploy/refresh time and the deploy FAILS
# if a feed cannot be read — a wrong price silently baked into every valuation is worse than
# no deployment.
# TESTNET_ETH_USD=
# TESTNET_USDG_USD=
# TESTNET_CBBTC_USD=

# A SEPARATE, dedicated key for the public faucet (frontend/app/api/faucet/route.ts). It never
# owns anything — grant it MINTER_ROLE on the token contracts only (see FaucetMintable.sol) and,
# for the native-ETH drip, fund it with testnet ETH directly. The faucet API refuses to fall back
# to DEPLOYER_PRIVATE_KEY if this is unset, on purpose: the faucet is the most publicly-reachable
# signer in the stack, and it must never be able to reach for the key that owns the deployment.
FAUCET_PRIVATE_KEY=

# ---- ops routes (ui/ console: /api/testnet-deploy, /api/testnet-treasury) -------------------
#
# Both routes sign with DEPLOYER_PRIVATE_KEY on the server. They are gated by ui/lib/opsGuard.ts
# and are OFF by default. Set these in the SERVER's own process environment (e.g. the shell that
# runs `next start`, or your deploy platform's secret store) — never in this file, next to the
# key they are meant to protect.
#
#   ENABLE_OPS_ROUTES=1
#   OPS_BEARER_TOKEN=<a random 32+ character string, e.g. `openssl rand -hex 32`>
#
# Send it as `Authorization: Bearer <token>` on requests to those two routes. Leave
# ENABLE_OPS_ROUTES unset (or anything other than "1") to keep them returning 404.

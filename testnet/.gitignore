# Secrets. testnet/.env holds DEPLOYER_PRIVATE_KEY and FAUCET_PRIVATE_KEY.
# There is no .gitignore at the repo root, and contracts/.gitignore and frontend/.gitignore
# only cover their own directories -- so before this file existed, `git init && git add .`
# would have committed both keys.
.env
.env.*
!.env.example

node_modules/

# LaunchAgent log for the oracle-refresh cron (see ~/Library/LaunchAgents/com.levera.testnet-refresh-prices.plist)
refresh-prices.log
keeper.log

# Copy to .env.local for local dev. On Vercel, set these as Project → Settings → Environment
# Variables instead -- never commit real values for anything below.

# --- Required ---

# Postgres. Locally this is your own instance; in production point it at Supabase's CONNECTION
# POOLER string (port 6543, `Transaction` mode), not the direct 5432 one -- serverless functions
# open a fresh connection per invocation, and the pooler is what survives that at any real
# concurrency. Get it from Supabase → Project Settings → Database → Connection string → "Transaction".
DATABASE_URL=postgresql://mac@127.0.0.1:5432/levera

# The chain RPC every read/write in this app goes through.
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.chain.robinhood.com

# The site's public origin, used as metadataBase for OG/social meta tags (frontend/app/layout.tsx).
# Without it og:image resolves to localhost and X/Discord embeds render no preview card. NEXT_PUBLIC_
# vars are inlined at build time, so set this in Vercel's env vars BEFORE deploying, not after.
NEXT_PUBLIC_SITE_URL=https://app.levera.fun

# --- Optional: each feature below degrades gracefully (hidden or a clear "not configured" error)
# when its own variables are unset, so none of these block a first deploy. ---

# WalletConnect connector. Free project ID at https://cloud.reown.com. Without it, WalletConnect is
# simply left out of the connect-a-wallet list.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# The testnet faucet's signer. MUST be a dedicated, separately-funded key -- never the deployer key
# (testnet/.env's DEPLOYER_PRIVATE_KEY), which owns the Earn Pool and both factories. The faucet is
# the most publicly-exposed signer in the whole stack: anyone with a wallet signature can trigger it.
# Locally this falls back to reading testnet/.env's FAUCET_PRIVATE_KEY off disk; that fallback reads
# a sibling directory that will not exist on Vercel, so this MUST be set explicitly there.
# FAUCET_PRIVATE_KEY=

# Arweave upload (the legacy /api/arweave/upload route). A JSON-stringified Arweave wallet
# keyfile. Token images on /create no longer use this -- they go to Pinata below.
# ARWEAVE_KEY_JSON=

# Pinata (IPFS pinning) -- where launched-token images are stored. Server-side only. Create a
# free account at pinata.cloud, generate an API JWT (API Keys -> New key, "Admin" scope works),
# and set it here. Without it, /create still works: images land in the Postgres blob store and
# the response says `pinned: false`.
# PINATA_JWT=
# Optional dedicated gateway (https://<name>.mypinata.cloud) used to fetch cached-out cids and
# to build the permanent `url` returned on upload. Defaults to https://ipfs.io.
# PINATA_GATEWAY=

# Upstream for app/api/rpc/testnet/route.ts, a same-origin proxy that fronts a paid/rate-limited
# RPC (e.g. Goldsky Edge) so its key never reaches the browser. Server-side only -- no NEXT_PUBLIC_
# prefix, unlike NEXT_PUBLIC_RPC_URL above. To actually use it, ALSO point NEXT_PUBLIC_RPC_URL at
# this app's own origin instead of the public RPC: https://app.levera.fun/api/rpc/testnet (the
# "testnet" in that path matters -- frontend/lib/chains.ts derives TARGETING_TESTNET by checking
# whether NEXT_PUBLIC_RPC_URL contains the string "testnet"). Falls back to the plain public RPC
# when unset, so this is optional.
# TESTNET_RPC_PROXY_URL=https://edge.goldsky.com/standard/evm/46630?key=YOUR_GOLDSKY_KEY

# X (Twitter) OAuth, for linking a profile to a wallet. All four or none.
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# X_REDIRECT_URI=
# X_STATE_SECRET=

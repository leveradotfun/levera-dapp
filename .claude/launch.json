{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "launchpad-ui",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "ui",
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "launchpad-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 3002
    },
    {
      "name": "landing-page",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "landing-page",
        "run",
        "dev",
        "--",
        "--port",
        "3005"
      ],
      "port": 3005
    }
  ]
}
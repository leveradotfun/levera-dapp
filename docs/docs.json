{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "palm",
  "name": "levera",
  "description": "A launchpad on Robinhood Chain, with an optional 2x overlay rented from a dollar-senior Earn Pool.",
  "colors": {
    "primary": "#ece3d1",
    "light": "#f4eee2",
    "dark": "#c9c1b2"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo.svg",
    "dark": "/logo.svg"
  },
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "styling": {
    "latex": true,
    "eyebrows": "section"
  },
  "fonts": {
    "family": "Inter"
  },
  "icons": {
    "library": "lucide"
  },
  "navbar": {
    "links": [
      {
        "label": "Launchpad",
        "href": "https://levera.fun"
      },
      {
        "label": "Console",
        "href": "https://console.levera.fun"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting started",
        "icon": "rocket",
        "pages": [
          "index",
          "quickstart",
          "what-this-is-not"
        ]
      },
      {
        "group": "Protocol",
        "icon": "scale",
        "pages": [
          "protocol/product",
          "protocol/actors",
          "protocol/invariants",
          "protocol/leverage",
          "protocol/routes",
          "protocol/netting",
          "protocol/earn-pool",
          "protocol/fees",
          "protocol/occupancy",
          "protocol/redeem",
          "protocol/multi-collateral",
          "protocol/failure-modes"
        ]
      },
      {
        "group": "Mechanics",
        "icon": "cog",
        "pages": [
          "mechanics/bonding-curve",
          "mechanics/graduation",
          "mechanics/amm",
          "mechanics/harvest",
          "mechanics/clones"
        ]
      },
      {
        "group": "Chain",
        "icon": "link",
        "pages": [
          "chain/robinhood",
          "chain/oracles",
          "chain/deploy"
        ]
      },
      {
        "group": "Apps",
        "icon": "layout-dashboard",
        "pages": [
          "apps/frontend",
          "apps/console",
          "apps/keepers",
          "apps/csv",
          "apps/database"
        ]
      },
      {
        "group": "Security",
        "icon": "shield",
        "pages": [
          "security/threat-model",
          "security/pause",
          "security/testnet"
        ]
      },
      {
        "group": "Reference",
        "icon": "book-open",
        "pages": [
          "reference/parameters",
          "reference/formula-sheet",
          "reference/contracts",
          "reference/glossary"
        ]
      }
    ]
  }
}
